# content out of the entry chunk (lib/posts.ts).
public/content/

# Image optimization backups
*.original

# Playwright
.playwright-mcp/

# Velite generated content layer
.velite/

# Git worktrees (used by superpowers subagent workflow)
.worktrees/

# Superpowers brainstorm session artifacts
.superpowers/

# Local Claude Code permission settings (per-machine, not project state)
.claude/

# Vite / TanStack Start build artifacts
.netlify/
app/routeTree.gen.ts
.tanstack/

# Chrome profiles left behind by the Lighthouse MCP server when it runs from
# WSL: the Windows path is taken as a literal directory name, so the whole
# `C:\Users\...` string becomes one directory in the repository root. Biome
# then walks them and reports every lock file as a broken symlink.
C:\\*
