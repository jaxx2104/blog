# script-src keeps 'unsafe-inline': the theme bootstrap in
# app/routes/__root.tsx is inline, and TanStack Start emits its own inline
# hydration payload. Their content changes every build, so
# hashes would have to be recomputed by the build, and a nonce is meaningless
# on statically served files. The rest of the policy is still worth having:
# frame-ancestors / object-src / base-uri / form-action close off clickjacking
# and injected <base> or <form> targets regardless of the script rule.
#
# The permissive parts are all load-bearing:
# - style-src 'unsafe-inline': components/features/profile/thumbnail.tsx sets
#   a style attribute, and React writes inline styles during hydration.
# - img-src https:: posts written between 2013 and 2020 hotlink images from
#   Amazon, imgur, Google and others; they are listed in the markdown.
# - frame-src youtube: two posts embed a video.
# - cloudflareinsights.com in script-src and connect-src: Web Analytics is
#   enabled on this project, and Pages injects its beacon into the HTML at the
#   edge. It is not in dist/client/, so grepping the build output — or curling
#   the site, which did not get the injection either — says it is not there.
#   The first policy shipped without it and the browser console was the only
#   place that said so. Check a real browser after touching script-src.
#
# font-src 'none' and the absence of fonts.googleapis.com from style-src are
# deliberate: the site ships no web fonts at all (styles/CLAUDE.md). Adding an
# @font-face back means widening both again, or it fails in the console only.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'none'; img-src 'self' data: https: http:; media-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/posts/*
  Cache-Control: public, max-age=31536000, immutable

# Per-post and per-index-page JSON (lib/posts.ts fetches these). The filenames
# are stable by design — they are derived from the permalink — so editing a
# post rewrites the file in place. That rules out `immutable`: the client has
# to revalidate, and Pages answers an unchanged file with a 304.
/content/*
  Cache-Control: public, max-age=0, must-revalidate
